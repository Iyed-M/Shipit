# Dashboard host. Projects are served at <project>.<SHIPIT_DOMAIN>, which needs
# a wildcard DNS record pointing at this server.
SHIPIT_DOMAIN=ship.example.com

# Bearer token for the API. Generate one with: openssl rand -hex 32
SHIPIT_ADMIN_TOKEN=

# Fine-grained GitHub token with read access to Contents and read/write access
# to Webhooks and Commit statuses, on the repos you deploy.
SHIPIT_GITHUB_TOKEN=

# Encrypts project env vars in the database. Generate one with:
# openssl rand -hex 32
# Back it up: without it, saved env vars can't be read, so losing it means
# entering them again.
SHIPIT_MASTER_KEY=

# Optional: serve one existing site as static files.
# SHIPIT_STATIC_HOST=example.com
# SHIPIT_STATIC_DIR=/var/www/example.com

# Optional: host ports, for running alongside something else on 80 and 443.
# SHIPIT_HTTP_PORT=80
# SHIPIT_HTTPS_PORT=443
